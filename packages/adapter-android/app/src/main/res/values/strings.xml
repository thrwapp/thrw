<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">thrw</string>

    <!-- AdapterForegroundService's persistent notification (required by
         Android for any foreground service - architecture.md, "System
         components"). -->
    <string name="adapter_notification_channel_name">thrw headset switching</string>
    <string name="adapter_notification_title">thrw is active</string>
    <string name="adapter_notification_text">Watching for calls and VoIP sessions to switch your headset</string>

    <!-- ui/ProvisioningActivity (#102): the launcher screen that writes
         AdapterProvisioning's account id / headset address and requests
         the manifest's runtime-dangerous permissions. -->
    <string name="provisioning_title">thrw setup</string>
    <string name="provisioning_explainer">thrw needs to know which relay account this device belongs to, and which already-paired headset it manages. Pair the headset in Android\'s Bluetooth settings first, then pick it below.</string>
    <string name="account_id_label">Relay account ID</string>
    <string name="account_id_hint">e.g. tom-personal</string>
    <string name="headset_address_label">Headset</string>
    <string name="save">Save</string>
    <!-- Deliberate: this screen doesn't start AdapterForegroundService -
         BootCompletedReceiver does, on boot. See ProvisioningActivity's kdoc. -->
    <string name="provisioning_saved">Saved. thrw starts watching after the next device restart.</string>
    <string name="error_account_id_blank">Enter your relay account ID</string>
    <string name="error_account_id_unsupported_characters">Use up to 64 letters, digits, dots, dashes or underscores — no spaces or slashes</string>
    <!-- #117: reworded for the picker (was "Enter the headset's Bluetooth
         address", from #102's free-text field) - ProvisioningInput's
         FieldError.HEADSET_ADDRESS_BLANK itself is unchanged, this is
         only the message shown for it. -->
    <string name="error_headset_address_blank">Select the headset\'s Bluetooth address</string>
    <string name="error_headset_address_malformed">Use six colon-separated hex pairs, like AA:BB:CC:DD:EE:FF</string>
    <!-- #117: BondedHeadsetsState's two non-list states. -->
    <string name="headset_permission_not_granted">Grant the Bluetooth permission above to see paired headsets.</string>
    <string name="headset_none_bonded">No paired headsets found. Pair your headset in Android\'s Bluetooth settings, then reopen this screen.</string>
    <!-- The picker's hint entry (position 0) - forces a deliberate choice
         rather than silently defaulting to whichever bonded device the
         platform happens to list first. -->
    <string name="headset_picker_placeholder">Select a headset…</string>
    <string name="permissions_explainer">thrw needs these permissions to see calls, switch the headset and show its ongoing notification.</string>
    <string name="permissions_all_granted">All required permissions granted.</string>
    <string name="permissions_missing">Not granted yet:\n%1$s</string>
    <string name="grant_permissions">Grant permissions</string>

    <!-- Notification-listener access (#107): a special-access Settings
         toggle, not a runtime permission - see ProvisioningActivity's kdoc
         and ui/NotificationAccess.kt. -->
    <string name="notification_access_explainer">thrw needs notification access to detect VoIP calls (Settings, not a permission dialog).</string>
    <string name="notification_access_granted">Notification access granted.</string>
    <string name="notification_access_missing">Not granted yet. Open Settings and turn on access for thrw.</string>
    <string name="open_notification_access_settings">Open notification access settings</string>
</resources>
