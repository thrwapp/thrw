<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">thrw</string>

    <!-- AdapterForegroundService's persistent notification (required by
         Android for any foreground service - architecture.md, "System
         components"). -->
    <string name="adapter_notification_channel_name">thrw headset switching</string>
    <string name="adapter_notification_title">thrw is active</string>
    <string name="adapter_notification_text">Watching for calls and VoIP sessions to switch your headset</string>

    <!-- ProvisioningActivity (#102): the launcher screen that writes
         AdapterProvisioning's two SharedPreferences keys and requests the
         manifest's three runtime-dangerous permissions. -->
    <string name="provisioning_title">thrw setup</string>
    <string name="provisioning_intro">This device needs an account and a paired headset before the thrw adapter can run.</string>
    <string name="provisioning_account_id_label">Account ID (letters, digits, and . _ : -)</string>
    <string name="provisioning_headset_address_label">Headset Bluetooth address (AA:BB:CC:DD:EE:FF)</string>
    <string name="provisioning_save">Save</string>
    <string name="provisioning_saved">Saved.</string>
    <string name="provisioning_not_saved">Not saved — fix the errors above.</string>
    <!-- Stated in the UI because this screen deliberately doesn't start the
         foreground service; BootCompletedReceiver is the start path. -->
    <string name="provisioning_restart_note">Restart the device to start the adapter with these settings.</string>
    <string name="provisioning_error_blank">Required.</string>
    <string name="provisioning_error_account_id_too_long">Too long.</string>
    <string name="provisioning_error_account_id_characters">Use only letters, digits, and . _ : -</string>
    <string name="provisioning_error_headset_address">Must look like AA:BB:CC:DD:EE:FF.</string>
    <string name="provisioning_permissions_heading">Permissions</string>
    <string name="provisioning_request_permissions">Grant permissions</string>
    <string name="provisioning_permissions_granted">All required permissions are granted.</string>
    <string name="provisioning_permissions_missing">Still needed: %1$s. If the prompt no longer appears, grant them in Android Settings.</string>
</resources>
