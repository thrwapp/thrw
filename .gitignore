# Play Store upload key (#132). Deliberately broad and repo-wide rather than
# scoped to adapter-android: a keystore accidentally saved anywhere in this
# tree must not be committable. Losing the upload key is recoverable via Play
# Console; publishing one is not.
keystore.properties
*.jks
*.keystore

